# Session cookie encryption — set a random 32+ char secret in production
NUXT_SESSION_PASSWORD=change-me-to-a-random-32-char-secret!!

# Keyed hash pepper for passcodes — NEVER change after go-live (it voids every passcode)
NUXT_PASSCODE_PEPPER=change-me-too

# Token the host cron sends to /api/cron/tick
NUXT_CRON_TOKEN=change-me-cron

# Web push (generate once: npx web-push generate-vapid-keys)
NUXT_PUBLIC_VAPID_PUBLIC_KEY=
NUXT_VAPID_PRIVATE_KEY=
NUXT_VAPID_SUBJECT=mailto:you@example.org

# SQLite location (the docker volume mounts /data)
NUXT_DB_PATH=./data/passport.db
